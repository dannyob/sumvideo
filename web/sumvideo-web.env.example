# Environment for sumvideo-web.service. systemd doesn't read your shell
# config, so PATH must include uv, sumvideo and ffmpeg.
PATH=/home/you/.local/bin:/usr/local/bin:/usr/bin:/bin
SUMVIDEO_WEB_PORT=8765
# Used when "publish to the archive" is ticked
SUMVIDEO_DIR=/var/www/example/videos/
SUMVIDEO_BASE_URL=https://example.com/videos/
